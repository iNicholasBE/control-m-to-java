<?xml version="1.0" encoding="utf-8"?>
<!-- written for the tests; element and attribute names as in public exportdeffolder examples -->
<DEFTABLE xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="Folder.xsd">
  <FOLDER DATACENTER="dc1" VERSION="920" PLATFORM="UNIX" FOLDER_NAME="FIN-GL">
    <JOB APPLICATION="FIN" SUB_APPLICATION="GL" JOBNAME="GL-LOAD" TASKTYPE="Command" NODEID="lnxapp01" CMDLINE="load.sh">
      <INCOND NAME="CORE-EXTRACT-OK" ODATE="ODAT" AND_OR="A"/>
      <QUANTITATIVE NAME="DB_CONNECTIONS" QUANT="1" ONOK="R" ONFAIL="R"/>
      <CONTROL NAME="GL_LEDGER" TYPE="E"/>
      <OUTCOND NAME="CORE-EXTRACT-OK" ODATE="ODAT" SIGN="-"/>
      <OUTCOND NAME="GL-LOAD-OK" ODATE="ODAT" SIGN="+"/>
    </JOB>
    <JOB APPLICATION="FIN" SUB_APPLICATION="GL" JOBNAME="GL-POST" TASKTYPE="Command" NODEID="lnxapp01">
      <INCOND NAME="GL-LOAD-OK" ODATE="ODAT" AND_OR="A"/>
      <OUTCOND NAME="GL-LOAD-OK" ODATE="ODAT" SIGN="-"/>
      <ON STMT="*" CODE="NOTOK">
        <DOCOND NAME="GL-POST-FAILED" ODATE="ODAT" SIGN="+"/>
      </ON>
    </JOB>
    <JOB APPLICATION="FIN" JOBNAME="GL-ALERT" TASKTYPE="Command" NODEID="lnxapp01">
      <INCOND NAME="GL-POST-FAILED" ODATE="ODAT" AND_OR="A"/>
    </JOB>
    <JOB APPLICATION="FIN" JOBNAME="GL-ARCHIVE" TASKTYPE="Command" NODEID="lnxapp01"/>
  </FOLDER>
  <SMART_FOLDER FOLDER_NAME="FIN-REPORTS" PLATFORM="UNIX" APPLICATION="FIN">
    <SUB_FOLDER JOBNAME="DAILY">
      <INCOND NAME="GL-LOAD-OK" ODATE="ODAT" AND_OR="A"/>
      <JOB JOBNAME="DAILY-PDF" TASKTYPE="Command" NODEID="lnxrep01"/>
    </SUB_FOLDER>
  </SMART_FOLDER>
  <FOLDER FOLDER_NAME="CORE" PLATFORM="MVS" DATACENTER="mf1">
    <JOB MEMNAME="CORE010" APPLICATION="CORE" TASKTYPE="Job" MEMLIB="PROD.JOBLIB">
      <OUTCOND NAME="CORE-EXTRACT-OK" SIGN="ADD" ODATE="ODAT"/>
    </JOB>
  </FOLDER>
</DEFTABLE>
