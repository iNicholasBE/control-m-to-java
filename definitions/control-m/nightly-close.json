{
  "NIGHTLY_CLOSE": {
    "Type": "Folder",
    "ControlmServer": "CTM_PROD",
    "OrderMethod": "Automatic",
    "Application": "FINANCE",
    "SubApplication": "NIGHTLY_CLOSE",
    "Description": "Reference chain for the control-m-to-java example repository. Same chain as nightly-close-jobrunr and nightly-close-spring-batch.",
    "When": {
      "RuleBasedCalendars": {
        "Included": [
          "BUSINESS_DAYS"
        ],
        "BUSINESS_DAYS": {
          "Type": "Calendar:RuleBased",
          "When": {
            "WeekDays": [
              "MON",
              "TUE",
              "WED",
              "THU",
              "FRI"
            ],
            "MonthDays": [
              "NONE"
            ],
            "DaysRelation": "OR",
            "ConfirmationCalendars": {
              "Calendar": "BANK_WORKDAYS",
              "ExceptionPolicy": "DoNotOrder"
            }
          }
        }
      }
    },
    "WAIT_POSITIONS": {
      "Host": "nightly-close-agents",
      "RunAs": "batchusr",
      "Application": "FINANCE",
      "SubApplication": "NIGHTLY_CLOSE",
      "Description": "Wait for the positions file of this order date in the inbox",
      "When": {
        "FromTime": "0100",
        "RuleBasedCalendars": {
          "Included": [
            "USE PARENT"
          ]
        }
      },
      "Type": "Job:FileWatcher:Create",
      "Path": "/data/nightly-close/inbox/POSITIONS-%%$ODATE.csv",
      "SearchInterval": "60",
      "TimeLimit": "300",
      "MinimumSize": "1B",
      "eventsToAdd": {
        "Type": "AddEvents",
        "Events": [
          {
            "Event": "WAIT_POSITIONS-TO-EXTRACT_POSITIONS"
          }
        ]
      }
    },
    "EXTRACT_POSITIONS": {
      "Host": "nightly-close-agents",
      "RunAs": "batchusr",
      "Application": "FINANCE",
      "SubApplication": "NIGHTLY_CLOSE",
      "Description": "Load the positions file into staging. Holds the positions dataset lock.",
      "When": {
        "FromTime": "0100",
        "RuleBasedCalendars": {
          "Included": [
            "USE PARENT"
          ]
        }
      },
      "Type": "Job:Command",
      "Command": "/opt/nightly-close/bin/extract.sh --file /data/nightly-close/inbox/POSITIONS-%%$ODATE.csv --business-date %%$ODATE",
      "RerunLimit": {
        "Times": "2",
        "Every": "5",
        "Units": "Minutes"
      },
      "POSITIONS_DATASET": {
        "Type": "Resource:Lock",
        "LockType": "Exclusive"
      },
      "eventsToWaitFor": {
        "Type": "WaitForEvents",
        "Events": [
          {
            "Event": "WAIT_POSITIONS-TO-EXTRACT_POSITIONS"
          }
        ]
      },
      "eventsToDelete": {
        "Type": "DeleteEvents",
        "Events": [
          {
            "Event": "WAIT_POSITIONS-TO-EXTRACT_POSITIONS"
          }
        ]
      },
      "eventsToAdd": {
        "Type": "AddEvents",
        "Events": [
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P01"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P02"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P03"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P04"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P05"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P06"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P07"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P08"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P09"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P10"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P11"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P12"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P13"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P14"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P15"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P16"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P17"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P18"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P19"
          },
          {
            "Event": "EXTRACT_POSITIONS-TO-SCORE_P20"
          }
        ]
      },
      "ActionIfFailure": {
        "Type": "If",
        "CompletionStatus": "NOTOK",
        "RerunExtract": {
          "Type": "Action:Rerun"
        }
      }
    },
    "SCORE_P01": {
      "Host": "nightly-close-agents",
      "RunAs": "batchusr",
      "Application": "FINANCE",
      "SubApplication": "NIGHTLY_CLOSE",
      "Description": "Risk scoring for portfolio partition 1 of 20",
      "When": {
        "FromTime": "0100",
        "RuleBasedCalendars": {
          "Included": [
            "USE PARENT"
          ]
