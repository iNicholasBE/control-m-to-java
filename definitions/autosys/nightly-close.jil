/* ---------------------------- aggregate ---------------------------- */
insert_job: NC_AGGREGATE
job_type: CMD
box_name: NC_BOX
machine: nc-agent-01
owner: batchusr
command: /opt/nightly-close/bin/aggregate.sh --business-date $${NC_BUSINESS_DATE}
condition: s(NC_SCORE_P01) AND s(NC_SCORE_P02) AND s(NC_SCORE_P03) AND s(NC_SCORE_P04) AND s(NC_SCORE_P05) AND s(NC_SCORE_P06) AND s(NC_SCORE_P07) AND s(NC_SCORE_P08) AND s(NC_SCORE_P09) AND s(NC_SCORE_P10) AND s(NC_SCORE_P11) AND s(NC_SCORE_P12) AND s(NC_SCORE_P13) AND s(NC_SCORE_P14) AND s(NC_SCORE_P15) AND s(NC_SCORE_P16) AND s(NC_SCORE_P17) AND s(NC_SCORE_P18) AND s(NC_SCORE_P19) AND s(NC_SCORE_P20)
max_exit_success: 0

/* ------------------------ regulatory report ------------------------ */
insert_job: NC_REPORT
job_type: CMD
box_name: NC_BOX
machine: nc-agent-01
owner: batchusr
command: /opt/nightly-close/bin/report.sh --business-date $${NC_BUSINESS_DATE} --out /data/nightly-close/outbox/REPORT-$${NC_BUSINESS_DATE}.csv
condition: s(NC_AGGREGATE)
max_exit_success: 0

/* ------------------------------ deliver ---------------------------- */
insert_job: NC_DELIVER
job_type: CMD
box_name: NC_BOX
machine: nc-agent-01
owner: batchusr
command: /opt/nightly-close/bin/deliver.sh --file /data/nightly-close/outbox/REPORT-$${NC_BUSINESS_DATE}.csv
condition: s(NC_REPORT)
n_retrys: 3
max_exit_success: 0
